{
  "name": "rodriguez-de-mello-sistemas",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio de Rodríguez de Mello Sistemas (GitHub Pages) y receptor del formulario (Google Apps Script), con sus baterías de pruebas.",
  "scripts": {
    "serve": "npx --yes http-server docs -p 8080 -c-1",
    "test": "bash tests/run-all.sh",
    "test:unit": "node --test --experimental-test-coverage tests/unit/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:security": "node --test --test-concurrency=1 tests/security/*.test.mjs",
    "lint": "eslint --no-eslintrc -c .eslintrc.json docs/assets/js/*.js"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "eslint": "8.57.0",
    "eslint-plugin-no-unsanitized": "4.0.2",
    "eslint-plugin-security": "1.7.1",
    "playwright": "1.56.1",
    "v8-to-istanbul": "9.3.0"
  }
}
